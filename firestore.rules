rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStageId(stageId) {
      return stageId is string && stageId.size() >= 1 && stageId.size() <= 3 && stageId.matches('^[1-9][0-9]{0,2}$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidDailyScoreId(scoreId) {
      return scoreId is string && scoreId.size() >= 12 && scoreId.size() <= 140 && scoreId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'currentLevelId',
          'tutorialSeen',
          'muted',
          'language',
          'solvedCount',
          'totalStars',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'currentLevelId',
          'tutorialSeen',
          'muted',
          'language',
          'solvedCount',
          'totalStars',
          'selectedTheme',
          'unlockedAchievements',
          'dailyCompletedDates',
          'dailyStreak',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() <= 160
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.currentLevelId is int
        && data.currentLevelId >= 1
        && data.currentLevelId <= 360
        && data.tutorialSeen is bool
        && data.muted is bool
        && data.language is string
        && data.language.size() == 2
        && (data.language == 'ar' || data.language == 'en')
        && data.solvedCount is int
        && data.solvedCount >= 0
        && data.solvedCount <= 360
        && data.totalStars is int
        && data.totalStars >= 0
        && data.totalStars <= 1080
        && (!('selectedTheme' in data) || (data.selectedTheme is string && data.selectedTheme.size() <= 20 && (data.selectedTheme == 'classic' || data.selectedTheme == 'night' || data.selectedTheme == 'rain' || data.selectedTheme == 'desert' || data.selectedTheme == 'snow' || data.selectedTheme == 'sunset' || data.selectedTheme == 'cyber' || data.selectedTheme == 'autumn')))
        && (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 30 && (data.unlockedAchievements.size() == 0 || (data.unlockedAchievements[0] is string && data.unlockedAchievements[0].size() <= 40))))
        && (!('dailyCompletedDates' in data) || (data.dailyCompletedDates is list && data.dailyCompletedDates.size() <= 100 && (data.dailyCompletedDates.size() == 0 || isValidDateKey(data.dailyCompletedDates[0]))))
        && (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 10000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStageProgress(data, userId, stageId) {
      return data.keys().hasAll([
          'userId',
          'levelId',
          'solved',
          'bestMoves',
          'stars',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'levelId',
          'solved',
          'bestMoves',
          'stars',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.levelId is int
        && data.levelId >= 1
        && data.levelId <= 360
        && string(data.levelId) == stageId
        && data.solved is bool
        && data.solved == true
        && data.bestMoves is int
        && data.bestMoves >= 1
        && data.bestMoves <= 9999
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 3
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'solvedCount',
          'totalStars',
          'achievementsCount',
          'dailyStreak',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'solvedCount',
          'totalStars',
          'achievementsCount',
          'dailyStreak',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.solvedCount is int
        && data.solvedCount >= 0
        && data.solvedCount <= 360
        && data.totalStars is int
        && data.totalStars >= 0
        && data.totalStars <= 1080
        && data.achievementsCount is int
        && data.achievementsCount >= 0
        && data.achievementsCount <= 30
        && data.dailyStreak is int
        && data.dailyStreak >= 0
        && data.dailyStreak <= 10000
        && data.updatedAt is timestamp;
    }

    function isValidDailyScore(data, scoreId) {
      return data.keys().hasAll([
          'userId',
          'dateKey',
          'levelId',
          'displayName',
          'photoURL',
          'moves',
          'timeSeconds',
          'stars',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'dateKey',
          'levelId',
          'displayName',
          'photoURL',
          'moves',
          'timeSeconds',
          'stars',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidDateKey(data.dateKey)
        && scoreId == data.dateKey + '_' + request.auth.uid
        && data.levelId is int
        && data.levelId >= 1
        && data.levelId <= 360
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.moves is int
        && data.moves >= 1
        && data.moves <= 9999
        && data.timeSeconds is int
        && data.timeSeconds >= 1
        && data.timeSeconds <= 86400
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 3
        && data.updatedAt is timestamp;
    }

    // /users/{userId} - Strictly Private Player Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'currentLevelId',
          'tutorialSeen',
          'muted',
          'language',
          'solvedCount',
          'totalStars',
          'selectedTheme',
          'unlockedAchievements',
          'dailyCompletedDates',
          'dailyStreak',
          'updatedAt'
        ]);

      allow delete: if false;

      // /users/{userId}/stages/{stageId} - Per-Stage Progress Subcollection
      match /stages/{stageId} {
        allow get: if isValidId(userId)
          && isValidStageId(stageId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isOwner(userId)
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidStageId(stageId)
          && isOwner(userId)
          && isValidStageProgress(incoming(), userId, stageId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidStageId(stageId)
          && isOwner(userId)
          && isValidStageProgress(incoming(), userId, stageId)
          && incoming().userId == existing().userId
          && incoming().levelId == existing().levelId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'bestMoves',
            'stars',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }
    }

    // /leaderboard/{userId} - Split Non-PII Public Ranking Collection
    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && isVerified();
      allow list: if isVerified() && resource.data.totalStars >= 0;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'solvedCount',
          'totalStars',
          'achievementsCount',
          'dailyStreak',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // /dailyScores/{scoreId} - Daily Challenge Global Leaderboard Entries
    match /dailyScores/{scoreId} {
      allow get: if isValidDailyScoreId(scoreId) && isVerified();
      allow list: if isVerified() && resource.data.dateKey is string;

      allow create: if isValidDailyScoreId(scoreId)
        && isVerified()
        && isValidDailyScore(incoming(), scoreId)
        && incoming().updatedAt == request.time;

      allow update: if isValidDailyScoreId(scoreId)
        && isVerified()
        && isValidDailyScore(incoming(), scoreId)
        && incoming().userId == existing().userId
        && incoming().dateKey == existing().dateKey
        && incoming().levelId == existing().levelId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'moves',
          'timeSeconds',
          'stars',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
