{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private player profile, preferences, theme, achievements, daily streak, and aggregate progress summary.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Player display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Private verified account email."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "currentLevelId": {
          "type": "integer",
          "description": "Active stage number from 1 to 360."
        },
        "tutorialSeen": {
          "type": "boolean",
          "description": "Whether the player completed or skipped the interactive tutorial."
        },
        "muted": {
          "type": "boolean",
          "description": "Audio mute preference."
        },
        "language": {
          "type": "string",
          "enum": ["ar", "en"],
          "description": "UI language preference."
        },
        "solvedCount": {
          "type": "integer",
          "description": "Total unique solved stages."
        },
        "totalStars": {
          "type": "integer",
          "description": "Total stars earned across all stages."
        },
        "selectedTheme": {
          "type": "string",
          "enum": ["classic", "night", "rain", "desert"],
          "description": "Selected visual board theme."
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "Bounded list of unlocked achievement badge IDs (max 30)."
        },
        "dailyCompletedDates": {
          "type": "array",
          "description": "Bounded list of completed YYYY-MM-DD daily challenge keys (max 100)."
        },
        "dailyStreak": {
          "type": "integer",
          "description": "Current daily challenge streak count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "currentLevelId",
        "tutorialSeen",
        "muted",
        "language",
        "solvedCount",
        "totalStars",
        "createdAt",
        "updatedAt"
      ]
    },
    "StageProgress": {
      "title": "StageProgress",
      "description": "Per-stage completion record for a player.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "levelId": {
          "type": "integer",
          "description": "Stage number between 1 and 360."
        },
        "solved": {
          "type": "boolean",
          "description": "Completion flag."
        },
        "bestMoves": {
          "type": "integer",
          "description": "Lowest move count achieved on this stage."
        },
        "stars": {
          "type": "integer",
          "description": "Best stars earned (0 to 3)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "levelId",
        "solved",
        "bestMoves",
        "stars",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Non-PII public leaderboard ranking record for a verified player.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Player Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public player display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "solvedCount": {
          "type": "integer",
          "description": "Total unique solved stages (0 to 360)."
        },
        "totalStars": {
          "type": "integer",
          "description": "Total stars earned (0 to 1080)."
        },
        "achievementsCount": {
          "type": "integer",
          "description": "Number of unlocked achievement badges (0 to 30)."
        },
        "dailyStreak": {
          "type": "integer",
          "description": "Daily challenge streak count."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "solvedCount",
        "totalStars",
        "achievementsCount",
        "dailyStreak",
        "updatedAt"
      ]
    },
    "DailyScore": {
      "title": "DailyScore",
      "description": "Daily challenge completion score submitted by a verified player.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Player Firebase Auth UID."
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "UTC challenge date key (YYYY-MM-DD)."
        },
        "levelId": {
          "type": "integer",
          "description": "Challenge stage ID (1 to 360)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public player display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "moves": {
          "type": "integer",
          "description": "Move count achieved."
        },
        "timeSeconds": {
          "type": "integer",
          "description": "Completion time in seconds."
        },
        "stars": {
          "type": "integer",
          "description": "Stars earned (0 to 3)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "dateKey",
        "levelId",
        "displayName",
        "photoURL",
        "moves",
        "timeSeconds",
        "stars",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private player profile and settings document, readable and writable only by the verified owner."
    },
    "/users/{userId}/stages/{stageId}": {
      "schema": {
        "$ref": "#/entities/StageProgress"
      },
      "description": "Individual stage progress documents owned by the user."
    },
    "/leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Split non-PII public leaderboard rankings readable by verified players and writable only by the matching owner."
    },
    "/dailyScores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/DailyScore"
      },
      "description": "Daily challenge scores keyed by YYYY-MM-DD_uid."
    }
  }
}
